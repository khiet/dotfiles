{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      /* Route file removal and moves through the repository's safe wrappers. */
      "rm *": "deny",
      "rmdir *": "deny",
      "unlink *": "deny",
      "mv *": "deny",
      "find *-delete*": "deny",
      "xargs rm *": "deny",
      "xargs * rm *": "deny",
      /* Do not let unattended runs escalate beyond the current user. */
      "sudo *": "deny",
      "doas *": "deny",
      "su *": "deny",
      /* Prevent local data loss and irreversible remote Git operations. */
      "git reset *--hard*": "deny",
      "git restore *": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git checkout *--force*": "deny",
      "git checkout -f *": "deny",
      "git switch *--discard-changes*": "deny",
      "git clean *": "deny",
      "git branch *-D*": "deny",
      "git branch *--delete*--force*": "deny",
      "git branch *--force*--delete*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "gh repo delete*": "deny"
    },
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
    },
    "aws-api": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "awslabs.aws-api-mcp-server@latest"
      ],
      "environment": {
        "AWS_REGION": "eu-west-2",
        "AWS_API_MCP_PROFILE_NAME": "pave",
        "READ_OPERATIONS_ONLY": "true",
      },
    },
    "aws-knowledge": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "fastmcp",
        "run",
        "https://knowledge-mcp.global.api.aws",
      ],
    },
    "cloudwatch": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "awslabs.cloudwatch-mcp-server@latest"
      ],
      "environment": {
        "AWS_PROFILE": "pave",
        "AWS_REGION": "eu-west-2",
        "FASTMCP_LOG_LEVEL": "ERROR",
      },
    },
    "elasticache": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "awslabs.elasticache-mcp-server@latest"
      ],
      "environment": {
        "AWS_PROFILE": "pave",
        "AWS_REGION": "eu-west-2",
        "FASTMCP_LOG_LEVEL": "ERROR",
      },
    },
    "iam": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "awslabs.iam-mcp-server@latest"
      ],
      "environment": {
        "AWS_PROFILE": "pave",
        "AWS_REGION": "eu-west-2",
        "FASTMCP_LOG_LEVEL": "ERROR",
      },
    },
    "ios-simulator": {
      "type": "local",
      "command": [
        "npx",
        "ios-simulator-mcp"
      ],
      "enabled": false,
    },
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:e2b": {
          "name": "Gemma 4 E2B (local)"
        }
      }
    }
  },
}
