{
  "settings": {
    "showStatusIcon": false
  },
  "mcpServers": {
    "context-mode": {
      "command": "context-mode"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "figma": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "ios-simulator": {
      "command": "npx",
      "args": ["ios-simulator-mcp"]
    },
    "aws-mcp": {
      "disabled": true,
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.7.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile", "pave",
        "--metadata", "AWS_REGION=eu-west-2"
      ]
    },
    "cloudwatch": {
      "disabled": true,
      "command": "uvx",
      "args": ["awslabs.cloudwatch-mcp-server@latest"],
      "env": {
        "AWS_PROFILE": "pave",
        "AWS_REGION": "eu-west-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "elasticache": {
      "disabled": true,
      "command": "uvx",
      "args": ["awslabs.elasticache-mcp-server@latest"],
      "env": {
        "AWS_PROFILE": "pave",
        "AWS_REGION": "eu-west-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "iam": {
      "disabled": true,
      "command": "uvx",
      "args": ["awslabs.iam-mcp-server@latest"],
      "env": {
        "AWS_PROFILE": "pave",
        "AWS_REGION": "eu-west-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
