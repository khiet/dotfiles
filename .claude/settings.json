{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(mv *)",
      "Bash(find *-delete*)",
      "Bash(xargs rm *)",
      "Bash(xargs * rm *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(su *)",
      "Bash(git reset *--hard*)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout *--force*)",
      "Bash(git checkout -f *)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git clean *)",
      "Bash(git branch *-D*)",
      "Bash(git branch *--delete*--force*)",
      "Bash(git branch *--force*--delete*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(gh repo delete*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": false,
    "context-mode@context-mode": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "skipAutoPermissionPrompt": true
}
