{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(mv *)",
      "Bash(find *-delete*)",
      "Bash(xargs rm *)",
      "Bash(xargs * rm *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(su *)",
      "Bash(git reset *--hard*)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout *--force*)",
      "Bash(git checkout -f *)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git clean *)",
      "Bash(git branch *-D*)",
      "Bash(git branch *--delete*--force*)",
      "Bash(git branch *--force*--delete*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(gh repo delete*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "jq -r '.model.display_name'"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": false
  },
  "theme": "auto",
  "preferredNotifChannel": "ghostty",
  "skipAutoPermissionPrompt": true
}
